# Copy to .env and fill in. Ports deliberately use an uncommon block (57xxx) so this
# stack never collides with other local projects (e.g. Miralynk's default 5432/6379/etc).

# Application
NODE_ENV=development
PORT=57800
APP_URL=http://localhost:57800

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=57432
DATABASE_URL=

# Database — test (isolated, wiped between E2E runs)
POSTGRES_TEST_DB=
POSTGRES_TEST_PORT=57433
DATABASE_TEST_URL=

# Redis
REDIS_PASSWORD=
REDIS_PORT=57379
REDIS_URL=
# Same Redis container, separate logical DB index so E2E runs never touch dev cache/blacklist keys
REDIS_TEST_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Auth — Google (traveler only, mobile sends an ID token directly, verified server-side,
# no OAuth redirect/callback flow — see docs/mobile/01-tech-stack.md)
GOOGLE_OAUTH_CLIENT_ID=

# Auth — Apple (traveler only, same direct-token-verification pattern)
APPLE_OAUTH_CLIENT_ID=

# Email — MailHog (dev)
MAIL_HOST=
MAIL_PORT=57025
MAIL_FROM=
MAIL_SECURE=false
MAILHOG_UI_PORT=58025

# Email — production SMTP provider (not yet chosen, ask before setting this up)
# MAIL_HOST=
# MAIL_PORT=
# MAIL_USER=
# MAIL_PASS=

# Storage — MinIO (dev)
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
MINIO_CONSOLE_PORT=57901

# Firebase Admin SDK (push notifications only, not used by the Auth module yet)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe (not used by the Auth module yet)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Admin-configurable thresholds
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# Logging
LOG_LEVEL=debug

# Swagger
SWAGGER_ENABLED=true
