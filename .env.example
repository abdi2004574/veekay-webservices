# Copy to .env and fill in. Ports deliberately use an uncommon block (57xxx) so this
# stack never collides with other local projects (e.g. Miralynk's default 5432/6379/etc).

# Application
NODE_ENV=development
PORT=57800
APP_URL=http://localhost:57800

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=57432
DATABASE_URL=

# Database — test (isolated, wiped between E2E runs)
POSTGRES_TEST_DB=
POSTGRES_TEST_PORT=57433
DATABASE_TEST_URL=

# Redis
REDIS_PASSWORD=
REDIS_PORT=57379
REDIS_URL=
# Same Redis container, separate logical DB index so E2E runs never touch dev cache/blacklist keys
REDIS_TEST_URL=

# JWT
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# Auth — Google (traveler only, mobile sends an ID token directly, verified server-side,
# no OAuth redirect/callback flow — see docs/mobile/01-tech-stack.md)
GOOGLE_OAUTH_CLIENT_ID=

# Auth — Apple (traveler only, same direct-token-verification pattern)
APPLE_OAUTH_CLIENT_ID=

# Email — MailHog (dev SMTP). All outbound emails in development are captured
# by MailHog and viewable in the web UI at http://localhost:MAILHOG_UI_PORT.
# No email ever leaves the host machine during local development.
MAIL_HOST=
MAIL_PORT=57025
MAIL_FROM=
MAIL_SECURE=false
MAILHOG_UI_PORT=58025

# Email — production SMTP provider (not yet chosen — ask before wiring it up).
# Uncomment and fill in to override the MailHog values above for a real
# deployment. The earlier duplicate-key version of this section silently
# shadowed the MailHog block and was merged into this single comment.
# MAIL_USER=
# MAIL_PASS=

# Storage — MinIO (dev)
S3_ENDPOINT=
# Host/port a browser or mobile client outside Docker can reach for presigned
# URLs. Leave blank to fall back to S3_ENDPOINT (fine outside docker-compose).
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
MINIO_CONSOLE_PORT=57901

# Firebase Admin SDK (push notifications only, not used by the Auth module yet)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=0
STRIPE_COMMISSION_PERCENT=10
# DEPRECATED: legacy agency-subscription variables via Stripe Billing.
# Agency subscriptions (Basic/Premium/Featured) are now handled by RevenueCat
# native IAP on iOS/Android - see REVENUECAT_* variables below, not Stripe.
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PREMIUM=
STRIPE_PRICE_FEATURED=

# Service portal credentials (non-standard env vars, stored here for reference)
# EXPO_ACCOUNT_EMAIL=
# EXPO_ACCOUNT_PASSWORD=
# RevenueCat — agency subscription webhook (RESOLVED 2026-09-12). Agency
# subscriptions (Basic/Premium/Featured) are purchased natively on iOS and
# Android via RevenueCat, NOT via Stripe. The backend receives the official
# RevenueCat envelope + X-RevenueCat-Webhook-Signature, verifies HMAC/timestamp,
# deduplicates with Redis, resolves the agency, and updates Agency.subscriptionTier.
REVENUECAT_WEBHOOK_SECRET=
# Tolerance (seconds) for the RevenueCat webhook signature timestamp. Requests
# older than this are rejected to prevent replay.
REVENUECAT_TIMESTAMP_TOLERANCE_SECONDS=300
# JSON object mapping RevenueCat entitlement/product IDs to agency tiers.
# Example: {"ent_basic":"basic","ent_premium":"premium","ent_featured":"featured"}
REVENUECAT_TIER_MAPPING={}
# SURFSHARK_EMAIL=
# SURFSHARK_PASSWORD=

# Admin-configurable thresholds
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MINUTES=15

# Logging
LOG_LEVEL=debug

# Swagger
SWAGGER_ENABLED=true
