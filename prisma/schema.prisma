generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────

enum UserRole {
  traveler
  agency
  admin
}

enum PlatformRole {
  user
  super_admin
}

enum TravelerBadge {
  dreamer
  explorer
  jetsetter
}

enum DestinationType {
  beach
  mountain
  city
  adventure
  cruise
}

enum TravelStyle {
  luxury
  budget
  backpacking
  family
  solo
  group
}

enum Gender {
  male
  female
  other
}

enum SocialProvider {
  google
  apple
}

enum OtpType {
  email_verify
  password_reset
  login
}

enum AgencyStatus {
  pending_verification
  approved
  rejected
}

enum AgencyDocumentType {
  business_license
  certification
  legal_document
}

enum AgencySubscriptionTier {
  basic
  premium
  featured
}

enum AgencyStaffPermission {
  owner
  staff
}

enum FriendRequestStatus {
  pending
  accepted
  declined
}

enum MediaPurpose {
  profile_photo
  previous_trip_photo
  post_media
  story_media
  agency_document
  agency_logo
  chat_image
  chat_document
  campaign_photo
  campaign_document
}

enum ConversationType {
  direct
  group
  agency
}

enum ConversationParticipantRole {
  member
  admin
}

enum MessageType {
  text
  image
  document
}

enum MessageReceiptStatus {
  delivered
  read
}

enum MediaStatus {
  pending
  uploaded
  deleted
}

enum StoryTextSize {
  small
  medium
  large
}

// No "funded"/"canceled" states yet — CreateCampaignScreen always publishes
// immediately (no save-draft UI), so every campaign is created `active`.
// `draft`/`completed` are modeled now for the real lifecycle figma's
// CampaignsScreen displays, but nothing transitions a campaign automatically
// (TRD open question #1, same "no lifecycle gate yet" default as reviews).
enum CampaignStatus {
  draft
  active
  completed
}

enum CampaignPrivacy {
  public
  private
}

enum ProfileVisibility {
  public
  friends
  private
}

// ─────────────────────────────────────────────────────────────
// USERS & AUTH
// ─────────────────────────────────────────────────────────────

model User {
  id                 String       @id @default(uuid())
  email              String       @unique
  username           String       @unique
  displayName        String?      @map("display_name")
  passwordHash       String?      @map("password_hash")
  role               UserRole
  platformRole       PlatformRole @default(user) @map("platform_role")
  isEmailVerified    Boolean      @default(false) @map("is_email_verified")
  isActive           Boolean      @default(true) @map("is_active")
  onboardingComplete Boolean      @default(false) @map("onboarding_complete")
  deactivatedAt      DateTime?    @map("deactivated_at")
  fcmToken           String?      @map("fcm_token")
  lastLoginAt        DateTime?    @map("last_login_at")
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")

  travelerProfile    TravelerProfile?
  notificationPreference NotificationPreference?
  privacySetting     PrivacySetting?
  agency             Agency?
  socialIdentities   SocialIdentity[]
  refreshTokens      RefreshToken[]
  adminTwoFactor     AdminTwoFactor?

  posts                   Post[]
  postLikes               PostLike[]
  comments                Comment[]
  commentLikes            CommentLike[]
  stories                 Story[]
  storyLikes              StoryLike[]
  storyViews              StoryView[]
  friendRequestsSent      FriendRequest[] @relation("FriendRequestsSent")
  friendRequestsReceived  FriendRequest[] @relation("FriendRequestsReceived")
  mediaAssets             MediaAsset[]
  conversationsCreated    Conversation[]
  conversationParticipants ConversationParticipant[]
  messages                Message[]
  messageReceipts         MessageReceipt[]
  agencyReviews           AgencyReview[]
  campaigns               Campaign[]
  groupMemberships        GroupMember[]
  groupContributions      GroupContribution[]
  groupExpensesPaid       GroupExpense[]

  @@map("users")
}

model TravelerProfile {
  userId                String    @id @map("user_id")
  photoMediaId          String?   @map("photo_media_id")
  bio                   String?
  location              String?
  phone                 String?
  gender                Gender?
  dateOfBirth           DateTime? @map("date_of_birth")
  badge                 TravelerBadge @default(dreamer)
  walletConnected        Boolean  @default(false) @map("wallet_connected")
  walletPaymentMethodId  String?  @map("wallet_payment_method_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  user               User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinationTypes   TravelerDestinationPreference[]
  travelStyles       TravelerTravelStylePreference[]
  previousTripPhotos TravelerPreviousTripPhoto[]

  @@map("traveler_profiles")
}

model TravelerPreviousTripPhoto {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  mediaId       String   @map("media_id")
  name          String
  location      String
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  travelerCount Int      @default(1) @map("traveler_count")
  description   String?
  createdAt     DateTime @default(now()) @map("created_at")

  travelerProfile TravelerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("traveler_previous_trip_photos")
}

model NotificationPreference {
  userId          String  @id @map("user_id")
  donationAlerts  Boolean @default(true) @map("donation_alerts")
  campaignUpdates Boolean @default(true) @map("campaign_updates")
  agencyMessages  Boolean @default(true) @map("agency_messages")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PrivacySetting {
  userId                String            @id @map("user_id")
  profileVisibility     ProfileVisibility @default(public) @map("profile_visibility")
  activityStatusVisible Boolean           @default(true) @map("activity_status_visible")
  readReceiptsEnabled   Boolean           @default(true) @map("read_receipts_enabled")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model TravelerDestinationPreference {
  userId          String          @map("user_id")
  destinationType DestinationType @map("destination_type")

  travelerProfile TravelerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, destinationType])
  @@map("traveler_destination_preferences")
}

model TravelerTravelStylePreference {
  userId      String      @map("user_id")
  travelStyle TravelStyle @map("travel_style")

  travelerProfile TravelerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, travelStyle])
  @@map("traveler_travel_style_preferences")
}

model SocialIdentity {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  provider       SocialProvider
  providerUserId String         @map("provider_user_id")
  createdAt      DateTime       @default(now()) @map("created_at")

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("social_identities")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @map("token_hash")
  deviceId   String?  @map("device_id")
  deviceName String?  @map("device_name")
  expiresAt  DateTime @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  createdAt  DateTime @default(now()) @map("created_at")

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OtpCode {
  id         String   @id @default(uuid())
  identifier String
  codeHash   String   @map("code_hash")
  type       OtpType
  attempts   Int      @default(0)
  expiresAt  DateTime @map("expires_at")
  isUsed     Boolean  @default(false) @map("is_used")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, type])
  @@map("otp_codes")
}

model AdminTwoFactor {
  userId      String   @id @map("user_id")
  secret      String
  isConfirmed Boolean  @default(false) @map("is_confirmed")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_two_factor")
}

// ─────────────────────────────────────────────────────────────
// AGENCIES
// ─────────────────────────────────────────────────────────────

model Agency {
  id               String                 @id @default(uuid())
  userId           String                 @unique @map("user_id")
  agencyName       String                 @map("agency_name")
  businessContact  String?                @map("business_contact")
  businessAddress  String?                @map("business_address")
  status           AgencyStatus           @default(pending_verification)
  rejectionReason  String?                @map("rejection_reason")
  reputationScore  Decimal?               @map("reputation_score")
  subscriptionTier AgencySubscriptionTier @default(basic) @map("subscription_tier")
  logoMediaId      String?                @map("logo_media_id")
  description      String?
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents        AgencyDocument[]
  staff            AgencyStaff[]
  conversations    Conversation[]
  reviews          AgencyReview[]

  @@map("agencies")
}

// One review per traveler per agency (edit/delete instead of stacking new
// ones) — matches figma's binary hasReviewed check and MyReviewsScreen's
// single-entry-per-agency list. No tripId/completed-trip gate yet: TRD open
// question #1 leaves "completed trip" undefined and there's no Trip/Booking
// model to gate against yet, so review creation is open to any traveler for
// now (documented, not silently skipped).
model AgencyReview {
  id            String   @id @default(uuid())
  agencyId      String   @map("agency_id")
  reviewerId    String   @map("reviewer_id")
  rating        Int
  body          String?
  editableUntil DateTime @map("editable_until")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  reviewer      User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([agencyId, reviewerId])
  @@map("agency_reviews")
}

model AgencyDocument {
  id        String             @id @default(uuid())
  agencyId  String             @map("agency_id")
  type      AgencyDocumentType
  mediaId   String             @map("media_id")
  createdAt DateTime           @default(now()) @map("created_at")

  agency    Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("agency_documents")
}

model AgencyStaff {
  id         String                @id @default(uuid())
  agencyId   String                @map("agency_id")
  userId     String                @map("user_id")
  permission AgencyStaffPermission @default(owner)
  createdAt  DateTime              @default(now()) @map("created_at")

  agency     Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@map("agency_staff")
}

// ─────────────────────────────────────────────────────────────
// SOCIAL FEED, STORIES & FRIENDS
// ─────────────────────────────────────────────────────────────

model Post {
  id           String    @id @default(uuid())
  authorId     String    @map("author_id")
  text         String
  imageMediaId String?   @map("image_media_id")
  location     String?
  tags         String[]
  repostOfId   String?   @map("repost_of_id")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  repostOf     Post?      @relation("PostReposts", fields: [repostOfId], references: [id], onDelete: SetNull)
  reposts      Post[]     @relation("PostReposts")
  likes        PostLike[]
  comments     Comment[]

  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model Comment {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  authorId  String   @map("author_id")
  text      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes     CommentLike[]

  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model Story {
  id              String         @id @default(uuid())
  authorId        String         @map("author_id")
  imageMediaId    String?        @map("image_media_id")
  text            String?
  backgroundColor String?        @map("background_color")
  textSize        StoryTextSize? @map("text_size")
  createdAt       DateTime       @default(now()) @map("created_at")
  expiresAt       DateTime       @map("expires_at")

  author          User        @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes           StoryLike[]
  views           StoryView[]

  @@map("stories")
}

model StoryLike {
  id        String   @id @default(uuid())
  storyId   String   @map("story_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("story_likes")
}

model StoryView {
  id        String   @id @default(uuid())
  storyId   String   @map("story_id")
  viewerId  String   @map("viewer_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer    User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@map("story_views")
}

model FriendRequest {
  id          String              @id @default(uuid())
  requesterId String              @map("requester_id")
  addresseeId String              @map("addressee_id")
  status      FriendRequestStatus @default(pending)
  createdAt   DateTime            @default(now()) @map("created_at")
  respondedAt DateTime?           @map("responded_at")

  requester   User @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee   User @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("friend_requests")
}

// ─────────────────────────────────────────────────────────────
// STORAGE
// ─────────────────────────────────────────────────────────────

model MediaAsset {
  id          String       @id @default(uuid())
  ownerId     String       @map("owner_id")
  purpose     MediaPurpose
  key         String       @unique
  contentType String       @map("content_type")
  status      MediaStatus  @default(pending)
  sizeBytes   Int?         @map("size_bytes")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

// ─────────────────────────────────────────────────────────────
// CHAT / MESSAGING
// ─────────────────────────────────────────────────────────────

model Conversation {
  id                String           @id @default(uuid())
  type              ConversationType
  title             String?
  createdById       String           @map("created_by_id")
  // Set only for type=agency. Staff are authorized via AgencyStaff.agencyId
  // matching this, not via an explicit ConversationParticipant row per staff
  // member — a shared team inbox, not per-agent membership. The traveler on
  // the other side of the conversation *does* get a normal participant row.
  agencyId          String?          @map("agency_id")
  lastMessageAt     DateTime?        @map("last_message_at")
  // Shared read cursor for the agency side of an agency conversation — any
  // staff member marking it read clears it for the whole team, same idea as
  // a shared support inbox. Direct/group conversations use each participant's
  // own lastReadAt instead.
  agencyLastReadAt  DateTime?        @map("agency_last_read_at")
  createdAt         DateTime         @default(now()) @map("created_at")

  createdBy         User             @relation(fields: [createdById], references: [id], onDelete: Cascade)
  agency            Agency?          @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  participants      ConversationParticipant[]
  messages          Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String                      @id @default(uuid())
  conversationId String                      @map("conversation_id")
  userId         String                      @map("user_id")
  role           ConversationParticipantRole @default(member)
  joinedAt       DateTime                    @default(now()) @map("joined_at")
  lastReadAt     DateTime?                   @map("last_read_at")
  leftAt         DateTime?                   @map("left_at")

  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String      @id @default(uuid())
  conversationId String      @map("conversation_id")
  senderId       String      @map("sender_id")
  type           MessageType @default(text)
  body           String?
  mediaId        String?     @map("media_id")
  fileName       String?     @map("file_name")
  createdAt      DateTime    @default(now()) @map("created_at")

  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation(fields: [senderId], references: [id], onDelete: Cascade)
  receipts       MessageReceipt[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageReceipt {
  id          String               @id @default(uuid())
  messageId   String               @map("message_id")
  userId      String               @map("user_id")
  status      MessageReceiptStatus
  deliveredAt DateTime?            @map("delivered_at")
  readAt      DateTime?            @map("read_at")

  message     Message              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_receipts")
}

// ─────────────────────────────────────────────────────────────
// CAMPAIGNS
// ─────────────────────────────────────────────────────────────

// Donation/withdrawal money-movement lives entirely in #6 (Payments) —
// nothing here reads/writes a Donation table because none exists yet.
// `viewsCount` is the one denormalized counter (incremented on detail
// fetch); contributor/donor counts shown in figma are computed as 0 until
// #6 ships real donations, never faked.
model Campaign {
  id             String          @id @default(uuid())
  creatorId      String          @map("creator_id")
  title          String
  destination    String
  goalAmount     Decimal         @map("goal_amount")
  currency       String          @default("USD")
  story          String?
  tripStartDate  DateTime        @map("trip_start_date")
  tripEndDate    DateTime?       @map("trip_end_date")
  status         CampaignStatus  @default(active)
  privacy        CampaignPrivacy @default(public)
  giftMode       Boolean         @default(false) @map("gift_mode")
  giftOccasion   String?         @map("gift_occasion")
  // Exactly one optional file per slot in the real screen (single upload
  // button each, not a list) — no separate CampaignDocument table needed.
  itineraryMediaId  String?      @map("itinerary_media_id")
  agencyQuoteMediaId String?     @map("agency_quote_media_id")
  viewsCount     Int             @default(0) @map("views_count")
  // Group-fund money logic (#8) — always forced private, never in public
  // discovery. groupConversationId stays null until the first member is
  // added (ConversationsService.create requires >=1 participant besides
  // the caller, so it can't be created at solo-creator time).
  isGroup             Boolean  @default(false) @map("is_group")
  groupConversationId String?  @unique @map("group_conversation_id")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  creator        User            @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  photos         CampaignPhoto[]
  groupMembers        GroupMember[]
  groupContributions  GroupContribution[]
  groupExpenses       GroupExpense[]

  @@index([creatorId])
  @@map("campaigns")
}

// Ordered, up-to-5 photo list (matches CreateCampaignScreen's "Up to 5" cap
// and individually-removable grid) — the first (position 0) doubles as the
// hero image shown on CampaignsScreen/CampaignDetailScreen.
model CampaignPhoto {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  mediaId    String   @map("media_id")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, position])
  @@map("campaign_photos")
}

enum GroupMemberRole {
  admin
  member
}

model GroupMember {
  id         String          @id @default(uuid())
  campaignId String          @map("campaign_id")
  userId     String          @map("user_id")
  role       GroupMemberRole @default(member)
  joinedAt   DateTime        @default(now()) @map("joined_at")

  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@map("group_members")
}

enum GroupContributionType {
  manual
  donation
}

// `donation`/`donationId` are schema-ready for #6 to hook into (an
// auto-recorded contribution from a real Donation) — never written this
// pass, only `manual` is ever created.
model GroupContribution {
  id            String                 @id @default(uuid())
  campaignId    String                 @map("campaign_id")
  memberUserId  String                 @map("member_user_id")
  amount        Decimal
  type          GroupContributionType  @default(manual)
  note          String?
  donationId    String?                @map("donation_id")
  createdAt     DateTime               @default(now()) @map("created_at")

  campaign      Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member        User     @relation(fields: [memberUserId], references: [id], onDelete: Cascade)

  @@map("group_contributions")
}

enum GroupExpenseCategory {
  transportation
  accommodation
  activities
  food
  other
}

model GroupExpense {
  id           String                @id @default(uuid())
  campaignId   String                @map("campaign_id")
  name         String
  amount       Decimal
  category     GroupExpenseCategory
  paidByUserId String                @map("paid_by_user_id")
  spentAt      DateTime              @default(now()) @map("spent_at")
  createdAt    DateTime              @default(now()) @map("created_at")

  campaign     Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  paidBy       User     @relation(fields: [paidByUserId], references: [id], onDelete: Cascade)

  @@map("group_expenses")
}
