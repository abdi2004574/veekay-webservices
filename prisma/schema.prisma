generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String                    @id @default(uuid())
  email                    String                    @unique
  passwordHash             String?                   @map("password_hash")
  role                     UserRole
  platformRole             PlatformRole              @default(user) @map("platform_role")
  isEmailVerified          Boolean                   @default(false) @map("is_email_verified")
  isActive                 Boolean                   @default(true) @map("is_active")
  onboardingComplete       Boolean                   @default(false) @map("onboarding_complete")
  deactivatedAt            DateTime?                 @map("deactivated_at")
  fcmToken                 String?                   @map("fcm_token")
  lastLoginAt              DateTime?                 @map("last_login_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  displayName              String?                   @map("display_name")
  username                 String                    @unique
  adminTwoFactor           AdminTwoFactor?
  agency                   Agency?
  agencyReviews            AgencyReview[]
  campaigns                Campaign[]
  commentLikes             CommentLike[]
  comments                 Comment[]
  conversationParticipants ConversationParticipant[]
  conversationsCreated     Conversation[]
  donations                Donation[]
  friendRequestsReceived   FriendRequest[]           @relation("FriendRequestsReceived")
  friendRequestsSent       FriendRequest[]           @relation("FriendRequestsSent")
  groupContributions       GroupContribution[]
  groupExpensesPaid        GroupExpense[]
  groupMemberships         GroupMember[]
  mediaAssets              MediaAsset[]
  messageReceipts          MessageReceipt[]
  messages                 Message[]
  notificationPreference   NotificationPreference?
  paymentMethods           PaymentMethod[]
  payoutAccounts           PayoutAccount[]
  postLikes                PostLike[]
  posts                    Post[]
  privacySetting           PrivacySetting?
  refreshTokens            RefreshToken[]
  socialIdentities         SocialIdentity[]
  stories                  Story[]
  storyLikes               StoryLike[]
  storyViews               StoryView[]
  stripeConnectAccounts    StripeConnectAccount[]
  travelerProfile          TravelerProfile?
  withdrawalRequests       WithdrawalRequest[]
  tripRequests             TripRequest[]

  @@map("users")
}

model TravelerProfile {
  userId                String                          @id @map("user_id")
  photoMediaId          String?                         @map("photo_media_id")
  badge                 TravelerBadge                   @default(dreamer)
  walletConnected       Boolean                         @default(false) @map("wallet_connected")
  walletPaymentMethodId String?                         @map("wallet_payment_method_id")
  createdAt             DateTime                        @default(now()) @map("created_at")
  updatedAt             DateTime                        @updatedAt @map("updated_at")
  bio                   String?
  location              String?
  dateOfBirth           DateTime?                       @map("date_of_birth")
  gender                Gender?
  phone                 String?
  destinationTypes      TravelerDestinationPreference[]
  previousTripPhotos    TravelerPreviousTripPhoto[]
  user                  User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  travelStyles          TravelerTravelStylePreference[]

  @@map("traveler_profiles")
}

model TravelerPreviousTripPhoto {
  id              String          @id @default(uuid())
  userId          String          @map("user_id")
  mediaId         String          @map("media_id")
  createdAt       DateTime        @default(now()) @map("created_at")
  description     String?
  endDate         DateTime        @map("end_date")
  location        String
  name            String
  startDate       DateTime        @map("start_date")
  travelerCount   Int             @default(1) @map("traveler_count")
  travelerProfile TravelerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@map("traveler_previous_trip_photos")
}

model NotificationPreference {
  userId          String  @id @map("user_id")
  donationAlerts  Boolean @default(true) @map("donation_alerts")
  campaignUpdates Boolean @default(true) @map("campaign_updates")
  agencyMessages  Boolean @default(true) @map("agency_messages")
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model PrivacySetting {
  userId                String            @id @map("user_id")
  profileVisibility     ProfileVisibility @default(public) @map("profile_visibility")
  activityStatusVisible Boolean           @default(true) @map("activity_status_visible")
  readReceiptsEnabled   Boolean           @default(true) @map("read_receipts_enabled")
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("privacy_settings")
}

model TravelerDestinationPreference {
  userId          String          @map("user_id")
  destinationType DestinationType @map("destination_type")
  travelerProfile TravelerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, destinationType])
  @@map("traveler_destination_preferences")
}

model TravelerTravelStylePreference {
  userId          String          @map("user_id")
  travelStyle     TravelStyle     @map("travel_style")
  travelerProfile TravelerProfile @relation(fields: [userId], references: [userId], onDelete: Cascade)

  @@id([userId, travelStyle])
  @@map("traveler_travel_style_preferences")
}

model SocialIdentity {
  id             String         @id @default(uuid())
  userId         String         @map("user_id")
  provider       SocialProvider
  providerUserId String         @map("provider_user_id")
  createdAt      DateTime       @default(now()) @map("created_at")
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("social_identities")
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  tokenHash  String   @map("token_hash")
  deviceId   String?  @map("device_id")
  deviceName String?  @map("device_name")
  expiresAt  DateTime @map("expires_at")
  isRevoked  Boolean  @default(false) @map("is_revoked")
  createdAt  DateTime @default(now()) @map("created_at")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}

model OtpCode {
  id         String   @id @default(uuid())
  identifier String
  codeHash   String   @map("code_hash")
  type       OtpType
  attempts   Int      @default(0)
  expiresAt  DateTime @map("expires_at")
  isUsed     Boolean  @default(false) @map("is_used")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([identifier, type])
  @@map("otp_codes")
}

model AdminTwoFactor {
  userId      String   @id @map("user_id")
  secret      String
  isConfirmed Boolean  @default(false) @map("is_confirmed")
  createdAt   DateTime @default(now()) @map("created_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_two_factor")
}

model Agency {
  id                    String                 @id @default(uuid())
  userId                String                 @unique @map("user_id")
  agencyName            String                 @map("agency_name")
  businessContact       String?                @map("business_contact")
  businessAddress       String?                @map("business_address")
  status                AgencyStatus           @default(pending_verification)
  rejectionReason       String?                @map("rejection_reason")
  reputationScore       Decimal?               @map("reputation_score")
  subscriptionTier      AgencySubscriptionTier @default(basic) @map("subscription_tier")
  logoMediaId           String?                @map("logo_media_id")
  description           String?
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  documents             AgencyDocument[]
  reviews               AgencyReview[]
  staff                 AgencyStaff[]
  conversations         Conversation[]
  packages              Package[]
  tripRequests          TripRequest[]
  smartReplyTemplates   SmartReplyTemplate[]
  stripeConnectAccounts StripeConnectAccount[]

  @@map("agencies")
}

model AgencyReview {
  id            String   @id @default(uuid())
  agencyId      String   @map("agency_id")
  reviewerId    String   @map("reviewer_id")
  rating        Int
  body          String?
  editableUntil DateTime @map("editable_until")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  agency        Agency   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  reviewer      User     @relation(fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([agencyId, reviewerId])
  @@map("agency_reviews")
}

model AgencyDocument {
  id        String             @id @default(uuid())
  agencyId  String             @map("agency_id")
  type      AgencyDocumentType
  mediaId   String             @map("media_id")
  createdAt DateTime           @default(now()) @map("created_at")
  agency    Agency             @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@map("agency_documents")
}

model AgencyStaff {
  id         String                @id @default(uuid())
  agencyId   String                @map("agency_id")
  userId     String                @map("user_id")
  permission AgencyStaffPermission @default(owner)
  createdAt  DateTime              @default(now()) @map("created_at")
  agency     Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@unique([agencyId, userId])
  @@map("agency_staff")
}

model Post {
  id           String     @id @default(uuid())
  authorId     String     @map("author_id")
  text         String
  imageMediaId String?    @map("image_media_id")
  location     String?
  tags         String[]
  repostOfId   String?    @map("repost_of_id")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  comments     Comment[]
  likes        PostLike[]
  author       User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  repostOf     Post?      @relation("PostReposts", fields: [repostOfId], references: [id])
  reposts      Post[]     @relation("PostReposts")

  @@map("posts")
}

model PostLike {
  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@map("post_likes")
}

model Comment {
  id        String        @id @default(uuid())
  postId    String        @map("post_id")
  authorId  String        @map("author_id")
  text      String
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")
  likes     CommentLike[]
  author    User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_likes")
}

model Story {
  id              String         @id @default(uuid())
  authorId        String         @map("author_id")
  imageMediaId    String?        @map("image_media_id")
  text            String?
  backgroundColor String?        @map("background_color")
  textSize        StoryTextSize? @map("text_size")
  createdAt       DateTime       @default(now()) @map("created_at")
  expiresAt       DateTime       @map("expires_at")
  author          User           @relation(fields: [authorId], references: [id], onDelete: Cascade)
  likes           StoryLike[]
  views           StoryView[]

  @@map("stories")
}

model StoryLike {
  id        String   @id @default(uuid())
  storyId   String   @map("story_id")
  userId    String   @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  story     Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@map("story_likes")
}

model StoryView {
  id       String   @id @default(uuid())
  storyId  String   @map("story_id")
  viewerId String   @map("viewer_id")
  viewedAt DateTime @default(now()) @map("viewed_at")
  story    Story    @relation(fields: [storyId], references: [id], onDelete: Cascade)
  viewer   User     @relation(fields: [viewerId], references: [id], onDelete: Cascade)

  @@unique([storyId, viewerId])
  @@map("story_views")
}

model FriendRequest {
  id          String              @id @default(uuid())
  requesterId String              @map("requester_id")
  addresseeId String              @map("addressee_id")
  status      FriendRequestStatus @default(pending)
  createdAt   DateTime            @default(now()) @map("created_at")
  respondedAt DateTime?           @map("responded_at")
  addressee   User                @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  requester   User                @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@map("friend_requests")
}

model MediaAsset {
  id          String       @id @default(uuid())
  ownerId     String       @map("owner_id")
  purpose     MediaPurpose
  key         String       @unique
  contentType String       @map("content_type")
  status      MediaStatus  @default(pending)
  sizeBytes   Int?         @map("size_bytes")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  owner       User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("media_assets")
}

model Conversation {
  id               String                    @id @default(uuid())
  type             ConversationType
  title            String?
  createdById      String                    @map("created_by_id")
  agencyId         String?                   @map("agency_id")
  lastMessageAt    DateTime?                 @map("last_message_at")
  agencyLastReadAt DateTime?                 @map("agency_last_read_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  participants     ConversationParticipant[]
  agency           Agency?                   @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  createdBy        User                      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  messages         Message[]
  tripRequest      TripRequest?

  @@map("conversations")
}

model ConversationParticipant {
  id             String                      @id @default(uuid())
  conversationId String                      @map("conversation_id")
  userId         String                      @map("user_id")
  role           ConversationParticipantRole @default(member)
  joinedAt       DateTime                    @default(now()) @map("joined_at")
  lastReadAt     DateTime?                   @map("last_read_at")
  leftAt         DateTime?                   @map("left_at")
  conversation   Conversation                @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String           @id @default(uuid())
  conversationId String           @map("conversation_id")
  senderId       String           @map("sender_id")
  type           MessageType      @default(text)
  body           String?
  mediaId        String?          @map("media_id")
  fileName       String?          @map("file_name")
  createdAt      DateTime         @default(now()) @map("created_at")
  receipts       MessageReceipt[]
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User             @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageReceipt {
  id          String               @id @default(uuid())
  messageId   String               @map("message_id")
  userId      String               @map("user_id")
  status      MessageReceiptStatus
  deliveredAt DateTime?            @map("delivered_at")
  readAt      DateTime?            @map("read_at")
  message     Message              @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@map("message_receipts")
}

model Campaign {
  id                  String                @id @default(uuid())
  creatorId           String                @map("creator_id")
  title               String
  destination         String
  goalAmount          Decimal               @map("goal_amount")
  currency            String                @default("USD")
  story               String?
  tripStartDate       DateTime              @map("trip_start_date")
  tripEndDate         DateTime?             @map("trip_end_date")
  status              CampaignStatus        @default(active)
  privacy             CampaignPrivacy       @default(public)
  giftMode            Boolean               @default(false) @map("gift_mode")
  giftOccasion        String?               @map("gift_occasion")
  itineraryMediaId    String?               @map("itinerary_media_id")
  agencyQuoteMediaId  String?               @map("agency_quote_media_id")
  viewsCount          Int                   @default(0) @map("views_count")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  groupConversationId String?               @unique @map("group_conversation_id")
  isGroup             Boolean               @default(false) @map("is_group")
  raisedAmount        Decimal               @default(0) @map("raised_amount")
  photos              CampaignPhoto[]
  creator             User                  @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  donations           Donation[]
  groupContributions  GroupContribution[]
  groupExpenses       GroupExpense[]
  groupMembers        GroupMember[]
  packageLinks        PackageCampaignLink[]
  withdrawalRequests  WithdrawalRequest[]
  tripRequests        TripRequest[]

  @@index([creatorId])
  @@map("campaigns")
}

model CampaignPhoto {
  id         String   @id @default(uuid())
  campaignId String   @map("campaign_id")
  mediaId    String   @map("media_id")
  position   Int
  createdAt  DateTime @default(now()) @map("created_at")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, position])
  @@map("campaign_photos")
}

model Package {
  id               String                @id @default(uuid())
  agencyId         String                @map("agency_id")
  title            String
  description      String?
  basePrice        Decimal               @map("base_price")
  currency         String                @default("USD")
  destinationType  DestinationType?      @map("destination_type")
  season           String?
  theme            String?
  itinerary        String?
  status           PackageStatus         @default(active)
  isDynamicPricing Boolean               @default(false) @map("is_dynamic_pricing")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  campaignLinks    PackageCampaignLink[]
  media            PackageMedia[]
  agency           Agency                @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  tripRequests     TripRequest[]

  @@index([agencyId])
  @@map("packages")
}

model PackageMedia {
  id           String   @id @default(uuid())
  packageId    String   @map("package_id")
  mediaId      String   @map("media_id")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at")
  package      Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, displayOrder])
  @@map("package_media")
}

model PackageCampaignLink {
  id         String   @id @default(uuid())
  packageId  String   @map("package_id")
  campaignId String   @map("campaign_id")
  createdAt  DateTime @default(now()) @map("created_at")
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  package    Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, campaignId])
  @@map("package_campaign_links")
}

model GroupMember {
  id         String          @id @default(uuid())
  campaignId String          @map("campaign_id")
  userId     String          @map("user_id")
  role       GroupMemberRole @default(member)
  joinedAt   DateTime        @default(now()) @map("joined_at")
  campaign   Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@map("group_members")
}

model GroupContribution {
  id           String                @id @default(uuid())
  campaignId   String                @map("campaign_id")
  memberUserId String                @map("member_user_id")
  amount       Decimal
  type         GroupContributionType @default(manual)
  note         String?
  donationId   String?               @map("donation_id")
  createdAt    DateTime              @default(now()) @map("created_at")
  campaign     Campaign              @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  member       User                  @relation(fields: [memberUserId], references: [id], onDelete: Cascade)

  @@map("group_contributions")
}

model GroupExpense {
  id           String               @id @default(uuid())
  campaignId   String               @map("campaign_id")
  name         String
  amount       Decimal
  category     GroupExpenseCategory
  paidByUserId String               @map("paid_by_user_id")
  spentAt      DateTime             @default(now()) @map("spent_at")
  createdAt    DateTime             @default(now()) @map("created_at")
  campaign     Campaign             @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  paidBy       User                 @relation(fields: [paidByUserId], references: [id], onDelete: Cascade)

  @@map("group_expenses")
}

model TripRequest {
  id              String            @id @default(uuid())
  travelerId      String            @map("traveler_id")
  agencyId        String            @map("agency_id")
  packageId       String?           @map("package_id")
  campaignId      String?           @map("campaign_id")
  status          TripRequestStatus @default(pending)
  initialMessage  String?           @map("initial_message")
  conversationId  String?           @unique @map("conversation_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  traveler        User              @relation(fields: [travelerId], references: [id], onDelete: Cascade)
  agency          Agency            @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  package         Package?          @relation(fields: [packageId], references: [id])
  campaign        Campaign?         @relation(fields: [campaignId], references: [id])
  conversation    Conversation?     @relation(fields: [conversationId], references: [id])

  @@index([travelerId])
  @@index([agencyId])
  @@map("trip_requests")
}

model SmartReplyTemplate {
  id         String    @id @default(uuid())
  agencyId   String    @map("agency_id")
  title      String
  body       String
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  agency     Agency    @relation(fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([agencyId])
  @@map("smart_reply_templates")
}

model StripeConnectAccount {
  id               String   @id @default(uuid())
  userId           String?  @map("user_id")
  agencyId         String?  @map("agency_id")
  stripeAccountId  String   @unique @map("stripe_account_id")
  payoutsEnabled   Boolean  @default(false) @map("payouts_enabled")
  chargesEnabled   Boolean  @default(false) @map("charges_enabled")
  detailsSubmitted Boolean  @default(false) @map("details_submitted")
  onboardingUrl    String?  @map("onboarding_url")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  agency           Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("stripe_connect_accounts")
}

model Donation {
  id                    String         @id @default(uuid())
  campaignId            String         @map("campaign_id")
  donorUserId           String?        @map("donor_user_id")
  amount                Decimal
  currency              String         @default("USD")
  isAnonymous           Boolean        @default(false) @map("is_anonymous")
  giftMessage           String?        @map("gift_message")
  isGift                Boolean        @default(false) @map("is_gift")
  stripePaymentIntentId String?        @unique @map("stripe_payment_intent_id")
  status                DonationStatus @default(pending)
  receiptEmailSentAt    DateTime?      @map("receipt_email_sent_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")
  campaign              Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  donor                 User?          @relation(fields: [donorUserId], references: [id])

  @@map("donations")
}

model PaymentMethod {
  id                    String            @id @default(uuid())
  userId                String            @map("user_id")
  stripePaymentMethodId String            @unique @map("stripe_payment_method_id")
  type                  PaymentMethodType
  brand                 String?
  last4                 String?
  expMonth              Int?              @map("exp_month")
  expYear               Int?              @map("exp_year")
  isDefault             Boolean           @default(false) @map("is_default")
  createdAt             DateTime          @default(now()) @map("created_at")
  updatedAt             DateTime          @updatedAt @map("updated_at")
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payment_methods")
}

model PayoutAccount {
  id                 String              @id @default(uuid())
  userId             String              @map("user_id")
  type               PayoutAccountType
  label              String
  maskedIdentifier   String              @map("masked_identifier")
  isDefault          Boolean             @default(false) @map("is_default")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  withdrawalRequests WithdrawalRequest[]

  @@map("payout_accounts")
}

model WithdrawalRequest {
  id              String           @id @default(uuid())
  userId          String           @map("user_id")
  campaignId      String?          @map("campaign_id")
  payoutAccountId String           @map("payout_account_id")
  amount          Decimal
  status          WithdrawalStatus @default(pending)
  stripePayoutId  String?          @unique @map("stripe_payout_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  campaign        Campaign?        @relation(fields: [campaignId], references: [id])
  payoutAccount   PayoutAccount    @relation(fields: [payoutAccountId], references: [id])
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("withdrawal_requests")
}

model StripeWebhookEvent {
  id               String    @id @default(uuid())
  eventId          String    @unique @map("event_id")
  eventType        String    @map("event_type")
  rawPayload       String    @map("raw_payload")
  processingStatus String    @default("pending") @map("processing_status")
  processedAt      DateTime? @map("processed_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  @@map("stripe_webhook_events")
}

